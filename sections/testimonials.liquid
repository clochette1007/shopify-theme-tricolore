<style>
.testimonials { background: #f8f9ff; padding: 80px 24px; }
.testimonials-inner { max-width: 1200px; margin: 0 auto; }
.testimonials h2 { text-align: center; color: var(--color-primary); font-size: clamp(26px,4vw,40px); font-weight: 900; text-transform: uppercase; margin-bottom: 12px; }
.testimonials-divider { width: 60px; height: 4px; background: var(--color-accent); margin: 0 auto 48px; border-radius: 2px; }
.testimonials-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 28px; }
.testimonial-card { background: #fff; border-radius: 10px; padding: 28px; border-left: 4px solid var(--color-accent); box-shadow: 0 2px 12px rgba(0,35,149,0.07); }
.testimonial-stars { color: var(--color-accent); font-size: 18px; margin-bottom: 14px; }
.testimonial-text { color: #444; font-size: 15px; line-height: 1.7; margin-bottom: 20px; font-style: italic; }
.testimonial-name { font-weight: 800; color: var(--color-primary); font-size: 14px; }
.testimonial-location { color: #aaa; font-size: 13px; }
@media (max-width: 768px) { .testimonials-grid { grid-template-columns: 1fr; } }
</style>

<section class="testimonials">
  <div class="testimonials-inner">
    <h2>{{ section.settings.title | default: "Ce qu'ils en disent" }}</h2>
    <div class="testimonials-divider"></div>
    <div class="testimonials-grid">
      {%- for block in section.blocks -%}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-text">« {{ block.settings.text }} »</p>
          <div class="testimonial-name">{{ block.settings.name }}</div>
          <div class="testimonial-location">{{ block.settings.location }}</div>
        </div>
      {%- else -%}
        <div style="grid-column:1/-1;text-align:center;color:#aaa;padding:40px;">Aucun témoignage configuré.</div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Témoignages",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Ce qu'ils en disent" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Témoignage",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Produit exceptionnel, livraison ultra rapide !" },
        { "type": "text", "id": "name", "label": "Nom", "default": "Marie D." },
        { "type": "text", "id": "location", "label": "Ville", "default": "Paris" }
      ]
    }
  ],
  "presets": [{ "name": "Témoignages", "blocks": [
    { "type": "testimonial", "settings": { "text": "Produit exceptionnel, livraison ultra rapide !", "name": "Marie D.", "location": "Paris" } },
    { "type": "testimonial", "settings": { "text": "Qualité irréprochable, je commande régulièrement.", "name": "Thomas L.", "location": "Lyon" } },
    { "type": "testimonial", "settings": { "text": "Enfin une marque 100% française qui tient ses promesses !", "name": "Sophie M.", "location": "Bordeaux" } }
  ]}]
}
{% endschema %}
