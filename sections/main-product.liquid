{% assign current_product = product %}

<section style="background:#fff;padding:60px 0;">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start;">

      <!-- IMAGES -->
      <div>
        {%- if current_product.featured_image -%}
          <img src="{{ current_product.featured_image | image_url: width: 900 }}" alt="{{ current_product.title | escape }}" style="width:100%;border-radius:8px;">
        {%- else -%}
          <div style="aspect-ratio:1;background:#f0f3ff;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:80px;">&#128246;</div>
        {%- endif -%}
        <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;">
          {%- for image in current_product.images limit: 4 -%}
            <img src="{{ image | image_url: width: 200 }}" alt="" style="width:80px;height:80px;object-fit:cover;border-radius:4px;border:2px solid transparent;cursor:pointer;" onclick="document.querySelector('.main-img').src='{{ image | image_url: width: 900 }}'">
          {%- endfor -%}
        </div>
      </div>

      <!-- INFO -->
      <div>
        <span style="display:inline-block;background:var(--color-accent);color:#fff;font-size:11px;font-weight:800;letter-spacing:0.15em;text-transform:uppercase;padding:4px 12px;border-radius:2px;margin-bottom:14px;">&#9917; &#201;dition Coupe du Monde</span>
        <h1 style="color:var(--color-primary);margin-bottom:12px;">{{ current_product.title }}</h1>
        <div style="font-size:22px;color:var(--color-accent);margin-bottom:6px;">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p style="font-size:13px;color:#888;margin-bottom:20px;">4,7/5 &middot; Plus de 850 avis v&eacute;rifi&eacute;s</p>
        <div style="font-size:36px;font-weight:900;color:var(--color-primary);margin-bottom:24px;">{{ current_product.price | money }}</div>

        {%- if current_product.description != blank -%}
          <div style="font-size:15px;color:#555;line-height:1.7;margin-bottom:28px;">{{ current_product.description }}</div>
        {%- endif -%}

        <form action="/cart/add" method="post">
          <input type="hidden" name="id" value="{{ current_product.selected_or_first_available_variant.id }}">
          {%- unless current_product.has_only_default_variant -%}
            {%- for option in current_product.options_with_values -%}
              <div style="margin-bottom:16px;">
                <label style="font-weight:700;font-size:13px;text-transform:uppercase;color:var(--color-primary);display:block;margin-bottom:8px;">{{ option.name }}</label>
                <select name="options[{{ option.name | escape }}]" style="width:100%;">
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}">{{ value }}</option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
          {%- endunless -%}
          <div style="display:flex;gap:12px;margin-bottom:16px;align-items:center;">
            <label style="font-weight:700;font-size:13px;text-transform:uppercase;color:var(--color-primary);">Quantit&eacute;</label>
            <input type="number" name="quantity" value="1" min="1" style="width:80px;">
          </div>
          <button type="submit" class="btn btn--primary" style="width:100%;font-size:16px;padding:18px;margin-bottom:12px;">&#128722; Ajouter au panier</button>
          <a href="/checkout" class="btn btn--accent" style="display:block;width:100%;font-size:16px;padding:18px;text-align:center;">&#9889; Acheter maintenant</a>
        </form>

        <div style="display:flex;gap:20px;margin-top:20px;justify-content:center;flex-wrap:wrap;">
          <span style="font-size:13px;color:#888;">&#128274; Paiement s&eacute;curis&eacute;</span>
          <span style="font-size:13px;color:#888;">&#128230; Envoi sous 24h</span>
          <span style="font-size:13px;color:#888;">&#8617;&#65039; Retour 30 jours</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
@media (max-width: 768px) {
  .main-product-grid { grid-template-columns: 1fr !important; }
}
</style>

{% schema %}
{
  "name": "Produit principal",
  "settings": [],
  "presets": [{"name": "Produit principal"}]
}
{% endschema %}
