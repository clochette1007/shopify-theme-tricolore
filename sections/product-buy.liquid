<style>
.product-buy {
  background: #fff;
  padding: 80px 24px;
}
.product-buy-inner {
  max-width: 900px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: start;
}
.product-buy__image {
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 8px 40px rgba(0,35,149,0.12);
}
.product-buy__image img { width: 100%; height: auto; display: block; }
.product-buy__badge {
  display: inline-block;
  background: var(--color-accent);
  color: #fff;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 2px;
  margin-bottom: 16px;
}
.product-buy__title {
  color: var(--color-primary);
  font-size: clamp(22px, 3vw, 34px);
  font-weight: 900;
  text-transform: uppercase;
  line-height: 1.15;
  margin-bottom: 16px;
}
.product-buy__price {
  font-size: 36px;
  font-weight: 900;
  color: var(--color-accent);
  margin-bottom: 24px;
}
.product-buy__desc {
  color: #555;
  font-size: 15px;
  line-height: 1.7;
  margin-bottom: 28px;
}
.product-buy__desc ul { padding-left: 20px; margin-top: 12px; }
.product-buy__desc li { margin-bottom: 8px; }
.btn-buy {
  width: 100%;
  background: var(--color-accent);
  color: #fff;
  border: none;
  padding: 18px;
  font-size: 17px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  border-radius: 6px;
  cursor: pointer;
  transition: opacity 0.2s;
  margin-bottom: 12px;
}
.btn-buy:hover { opacity: 0.88; }
.btn-secondary {
  width: 100%;
  background: transparent;
  color: var(--color-primary);
  border: 2px solid var(--color-primary);
  padding: 14px;
  font-size: 15px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s;
  text-decoration: none;
  display: block;
  text-align: center;
}
.btn-secondary:hover { background: var(--color-primary); color: #fff; }
.product-buy__reassurance {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  margin-top: 24px;
}
.reassurance-item {
  font-size: 13px;
  color: #777;
  font-weight: 600;
}
.added-msg {
  display: none;
  background: #e8f5e9;
  color: #2e7d32;
  border-radius: 4px;
  padding: 12px 16px;
  font-weight: 700;
  font-size: 14px;
  margin-bottom: 12px;
  text-align: center;
}
@media (max-width: 768px) {
  .product-buy-inner { grid-template-columns: 1fr; gap: 32px; }
}
</style>

<section class="product-buy" id="acheter">
  <div class="product-buy-inner">

    <div class="product-buy__image">
      <img src="https://cdn.shopify.com/s/files/1/1054/2147/2081/files/photo_038ccb5e-dc9b-4584-a220-345a40a81f1e.png?v=1781269346" alt="Décapsuleur Catapulte Crafter">
    </div>

    <div>
      <span class="product-buy__badge">★ Bestseller</span>
      <h2 class="product-buy__title">Décapsuleur Catapulte Crafter</h2>
      <div class="product-buy__price">14,99 €</div>
      <div class="product-buy__desc">
        <p><strong>Lance ta capsule, célèbre le but.</strong></p>
        <p>Le décapsuleur Crafter propulse ta capsule jusqu'à 5 mètres d'une simple pression. Conçu pour les soirées foot, les apéros entre amis et ceux qui ouvrent leur bière avec style.</p>
        <ul>
          <li>✅ Ouverture ultra rapide et sans effort</li>
          <li>🎯 Catapulte la capsule jusqu'à 5 m</li>
          <li>🖤 Design compact et solide</li>
          <li>🍺 Idéal pour les soirées et cadeaux</li>
        </ul>
      </div>

      <div class="added-msg" id="added-msg">✅ Ajouté au panier !</div>
      <button class="btn-buy" id="btn-buy" onclick="ajouterAuPanier()">🛒 Ajouter au panier</button>
      <a href="/cart" class="btn-secondary">Voir mon panier</a>

      <div class="product-buy__reassurance">
        <span class="reassurance-item">🚚 Livraison rapide</span>
        &nbsp;·&nbsp;
        <span class="reassurance-item">🔒 Paiement sécurisé</span>
        &nbsp;·&nbsp;
        <span class="reassurance-item">🔄 Retours faciles</span>
      </div>
    </div>

  </div>
</section>

<script>
function ajouterAuPanier() {
  var msg = document.getElementById('added-msg');
  var btn = document.getElementById('btn-buy');
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: 54055447527761, quantity: 1 })
  })
  .then(function(r) { return r.json(); })
  .then(function() {
    msg.style.display = 'block';
    btn.textContent = '✅ Ajouté !';
    setTimeout(function() {
      msg.style.display = 'none';
      btn.textContent = '🛒 Ajouter au panier';
    }, 3000);
    fetch('/cart.js').then(function(r) { return r.json(); }).then(function(c) {
      var el = document.querySelector('.cart-count');
      if (el) el.textContent = c.item_count;
    });
  })
  .catch(function() {
    window.location.href = '/cart/add?id=54055447527761&quantity=1';
  });
}
</script>

{% schema %}
{ "name": "Produit à acheter", "settings": [], "presets": [{ "name": "Produit à acheter" }] }
{% endschema %}
