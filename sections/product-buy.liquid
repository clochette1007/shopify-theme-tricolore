<style>
.product-buy {
  background: #fff;
  padding: 80px 24px;
}
.product-buy-inner {
  max-width: 900px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: start;
}
.product-buy__image {
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 8px 40px rgba(0,35,149,0.12);
}
.product-buy__image img { width: 100%; height: auto; display: block; }
.product-buy__info {}
.product-buy__badge {
  display: inline-block;
  background: var(--color-accent);
  color: #fff;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 2px;
  margin-bottom: 16px;
}
.product-buy__title {
  color: var(--color-primary);
  font-size: clamp(22px, 3vw, 34px);
  font-weight: 900;
  text-transform: uppercase;
  line-height: 1.15;
  margin-bottom: 16px;
}
.product-buy__price {
  font-size: 36px;
  font-weight: 900;
  color: var(--color-accent);
  margin-bottom: 24px;
}
.product-buy__desc {
  color: #555;
  font-size: 15px;
  line-height: 1.7;
  margin-bottom: 28px;
}
.product-buy__desc ul { padding-left: 20px; margin-top: 12px; }
.product-buy__desc li { margin-bottom: 8px; }
.product-buy__form {}
.btn-buy {
  width: 100%;
  background: var(--color-accent);
  color: #fff;
  border: none;
  padding: 18px;
  font-size: 17px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  border-radius: 6px;
  cursor: pointer;
  transition: opacity 0.2s;
  margin-bottom: 12px;
}
.btn-buy:hover { opacity: 0.88; }
.btn-secondary {
  width: 100%;
  background: transparent;
  color: var(--color-primary);
  border: 2px solid var(--color-primary);
  padding: 14px;
  font-size: 15px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s;
  text-decoration: none;
  display: block;
  text-align: center;
}
.btn-secondary:hover { background: var(--color-primary); color: #fff; }
.product-buy__reassurance {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  margin-top: 24px;
}
.reassurance-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: #777;
  font-weight: 600;
}
.added-msg {
  display: none;
  background: #e8f5e9;
  color: #2e7d32;
  border-radius: 4px;
  padding: 12px 16px;
  font-weight: 700;
  font-size: 14px;
  margin-bottom: 12px;
  text-align: center;
}
@media (max-width: 768px) {
  .product-buy-inner { grid-template-columns: 1fr; gap: 32px; }
}
</style>

{%- assign product = all_products['decapsuleur-catapulte-crafter'] -%}
{%- if product == empty -%}
  {%- assign product = all_products.first -%}
{%- endif -%}

<section class="product-buy" id="acheter">
  <div class="product-buy-inner">
    <div class="product-buy__image">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}">
      {%- else -%}
        <img src="https://cdn.shopify.com/s/files/1/1054/2147/2081/files/photo.png?v=1781266719" alt="Décapsuleur Crafter">
      {%- endif -%}
    </div>
    <div class="product-buy__info">
      <span class="product-buy__badge">★ Bestseller</span>
      <h2 class="product-buy__title">{{ product.title | default: 'Décapsuleur Catapulte Crafter' }}</h2>
      <div class="product-buy__price">{{ product.price | money }}</div>
      <div class="product-buy__desc">{{ product.description }}</div>

      {%- form 'product', product, id: 'product-form-homepage' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <div class="added-msg" id="added-msg">✅ Ajouté au panier !</div>
        <button type="submit" class="btn-buy" id="btn-buy">🛒 Ajouter au panier</button>
        <a href="/cart" class="btn-secondary">Voir mon panier</a>
      {%- endform -%}

      <div class="product-buy__reassurance">
        <span class="reassurance-item">🚚 Livraison rapide</span>
        <span class="reassurance-item">🔒 Paiement sécurisé</span>
        <span class="reassurance-item">🔄 Retours faciles</span>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  var form = document.getElementById('product-form-homepage');
  var msg = document.getElementById('added-msg');
  var btn = document.getElementById('btn-buy');
  if (!form) return;
  form.addEventListener('submit', function(e){
    e.preventDefault();
    var fd = new FormData(form);
    fetch('/cart/add.js', { method: 'POST', body: fd })
      .then(function(r){ return r.json(); })
      .then(function(){
        msg.style.display = 'block';
        btn.textContent = '✅ Ajouté !';
        setTimeout(function(){ msg.style.display='none'; btn.textContent='🛒 Ajouter au panier'; }, 3000);
        fetch('/cart.js').then(function(r){ return r.json(); }).then(function(c){
          var el = document.querySelector('.cart-count');
          if(el) el.textContent = c.item_count;
        });
      });
  });
})();
</script>

{% schema %}
{ "name": "Produit à acheter", "settings": [], "presets": [{ "name": "Produit à acheter" }] }
{% endschema %}
