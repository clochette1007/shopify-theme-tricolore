<style>
.site-header {
  background: var(--color-primary);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}
.header-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64px;
}
.header-logo {
  color: #fff;
  font-size: 26px;
  font-weight: 900;
  text-decoration: none;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}
.header-logo span { color: var(--color-accent); }
.header-cart {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #fff;
  text-decoration: none;
  font-weight: 700;
  font-size: 15px;
  background: var(--color-accent);
  padding: 10px 20px;
  border-radius: 4px;
  transition: opacity 0.2s;
}
.header-cart:hover { opacity: 0.88; }
.cart-icon { font-size: 18px; }
.cart-count {
  background: #fff;
  color: var(--color-accent);
  border-radius: 50%;
  width: 20px;
  height: 20px;
  font-size: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
}
</style>

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="header-logo">CRAFT<span>ER</span></a>
    <a href="/cart" class="header-cart">
      <span class="cart-icon">🛒</span>
      Panier
      <span class="cart-count">{{ cart.item_count }}</span>
    </a>
  </div>
</header>

{% schema %}
{ "name": "En-tête", "settings": [] }
{% endschema %}
