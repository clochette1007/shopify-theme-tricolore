<section class="section" style="background:#f5f7ff;">
  <div class="container">
    <h2 class="section-title">{{ section.settings.title | default: 'Nos Collections' }}</h2>
    <div class="grid-3" style="margin-top:40px;">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.url | default: '/collections/all' }}" style="display:block;position:relative;border-radius:8px;overflow:hidden;aspect-ratio:4/3;text-decoration:none;">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title }}" style="width:100%;height:100%;object-fit:cover;">
          {%- else -%}
            <div style="width:100%;height:100%;background:var(--color-primary);"></div>
          {%- endif -%}
          <!-- OVERLAY -->
          <div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(0,35,149,0.85) 0%, rgba(0,35,149,0.3) 50%, transparent 100%);"></div>
          <div style="position:absolute;bottom:24px;left:24px;right:24px;">
            <h3 style="color:#fff;margin-bottom:10px;">{{ block.settings.title | default: 'Collection' }}</h3>
            <span style="display:inline-block;background:var(--color-accent);color:#fff;font-size:12px;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;padding:6px 16px;border-radius:2px;">Découvrir</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Grille de collections",
  "settings": [
    {"type": "text", "id": "title", "label": "Titre", "default": "Nos Collections"}
  ],
  "blocks": [
    {
      "type": "collection_tile",
      "name": "Tuile collection",
      "settings": [
        {"type": "text",         "id": "title", "label": "Titre",  "default": "Nouvelle collection"},
        {"type": "image_picker", "id": "image", "label": "Image"},
        {"type": "url",          "id": "url",   "label": "Lien"}
      ]
    }
  ],
  "presets": [{
    "name": "Grille de collections",
    "blocks": [
      {"type": "collection_tile", "settings": {"title": "Accessoires"}},
      {"type": "collection_tile", "settings": {"title": "Vêtements"}},
      {"type": "collection_tile", "settings": {"title": "Cadeaux"}}
    ]
  }]
}
{% endschema %}
