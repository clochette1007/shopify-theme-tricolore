<style>
.hero {
  background: var(--color-primary);
  padding: 80px 24px 60px;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -8%;
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, rgba(237,41,57,0.2) 0%, transparent 70%);
  pointer-events: none;
}
.hero-eyebrow {
  display: inline-block;
  background: var(--color-accent);
  color: #fff;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 6px 16px;
  border-radius: 2px;
  margin-bottom: 28px;
  position: relative;
  z-index: 2;
}
.hero-title {
  color: #fff;
  font-size: clamp(32px, 5vw, 68px);
  font-weight: 900;
  text-transform: uppercase;
  line-height: 1.1;
  text-align: center;
  margin-bottom: 16px;
  position: relative;
  z-index: 2;
}
.hero-title em {
  font-style: normal;
  color: var(--color-accent);
}
.hero-sub {
  color: rgba(255,255,255,0.8);
  font-size: 18px;
  text-align: center;
  margin-bottom: 60px;
  position: relative;
  z-index: 2;
}
.hero-bottom {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1000px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 60px;
}
.hero-photo {
  flex: 0 0 auto;
  width: clamp(240px, 32vw, 420px);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 24px 60px rgba(0,0,0,0.45);
}
.hero-photo img { width: 100%; height: auto; display: block; }
.hero-slogan {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.hero-slogan-line {
  font-size: clamp(38px, 5.5vw, 76px);
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  line-height: 1;
  color: #fff;
  white-space: nowrap;
}
.hero-slogan-line.red { color: var(--color-accent); }
.hero-slogan-line.with-icon::after { content: ' 🍺'; font-size: 0.6em; }
@media (max-width: 768px) {
  .hero-bottom { flex-direction: column; gap: 32px; }
  .hero-slogan { align-items: center; }
}
</style>

<section class="hero">
  <div class="hero-eyebrow">🇫🇷 Nouvelle collection 2026</div>
  <h1 class="hero-title">Imprimé en 3D pour <em>trinquer</em> aux Français.</h1>
  <p class="hero-sub">Des décapsuleurs conçus pour ceux qui aiment partager un bon verre.</p>
  <div class="hero-bottom">
    <div class="hero-photo">
      <img src="https://cdn.shopify.com/s/files/1/1054/2147/2081/files/photo.png?v=1781266719" alt="Décapsuleur Crafter">
    </div>
    <div class="hero-slogan">
      <div class="hero-slogan-line">PRÊTS</div>
      <div class="hero-slogan-line red">MARQUEZ</div>
      <div class="hero-slogan-line with-icon">DECAPSULEZ&thinsp;!</div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Bannière héro", "settings": [], "presets": [{ "name": "Bannière héro" }] }
{% endschema %}
