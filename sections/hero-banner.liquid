<style>
.hero {
  background: var(--color-primary);
  padding: 100px 24px 80px;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -8%;
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, rgba(237,41,57,0.2) 0%, transparent 70%);
  pointer-events: none;
}
.hero-eyebrow {
  display: inline-block;
  background: var(--color-accent);
  color: #fff;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 6px 16px;
  border-radius: 2px;
  margin-bottom: 28px;
  position: relative;
  z-index: 2;
}
.hero-title {
  color: #fff;
  font-size: clamp(32px, 5vw, 68px);
  font-weight: 900;
  text-transform: uppercase;
  line-height: 1.1;
  text-align: center;
  margin-bottom: 20px;
  position: relative;
  z-index: 2;
}
.hero-title em {
  font-style: normal;
  color: var(--color-accent);
}
.hero-sub {
  color: rgba(255,255,255,0.8);
  font-size: clamp(15px, 2vw, 19px);
  text-align: center;
  max-width: 520px;
  line-height: 1.6;
  position: relative;
  z-index: 2;
}
</style>

<section class="hero">
  <div class="hero-eyebrow">🇫🇷 Nouvelle collection 2026</div>
  <h1 class="hero-title">Imprimé en 3D pour <em>trinquer</em> aux Français.</h1>
  <p class="hero-sub">Des décapsuleurs conçus pour ceux qui aiment partager un bon verre.</p>
</section>

{% schema %}
{ "name": "Bannière héro", "settings": [], "presets": [{ "name": "Bannière héro" }] }
{% endschema %}
