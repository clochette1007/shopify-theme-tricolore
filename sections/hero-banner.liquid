<section class="hero" style="background:var(--color-primary);min-height:85vh;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;">

  {%- if section.settings.image != blank -%}
    <div style="position:absolute;inset:0;">
      <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="Hero" style="width:100%;height:100%;object-fit:cover;opacity:0.25;">
    </div>
  {%- else -%}
    <!-- Dégradé décoratif tricolore -->
    <div style="position:absolute;bottom:0;left:0;width:40%;height:6px;background:var(--color-accent);"></div>
    <div style="position:absolute;bottom:0;left:40%;width:20%;height:6px;background:#fff;"></div>
    <div style="position:absolute;bottom:0;left:60%;width:40%;height:6px;background:var(--color-primary);"></div>
    <div style="position:absolute;top:-80px;right:-80px;width:400px;height:400px;border-radius:50%;background:var(--color-accent);opacity:0.07;"></div>
  {%- endif -%}

  <div class="container" style="position:relative;z-index:1;text-align:center;padding:80px 24px;">
    {%- if section.settings.eyebrow != blank -%}
      <p style="font-size:13px;font-weight:700;letter-spacing:0.25em;text-transform:uppercase;color:var(--color-accent);margin-bottom:16px;">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 style="color:#fff;margin-bottom:20px;">{{ section.settings.heading | default: 'Fait en France.<br><span style="color:var(--color-accent);">Pour la France.</span>' }}</h1>

    {%- if section.settings.subheading != blank -%}
      <p style="font-size:18px;color:rgba(255,255,255,0.85);max-width:600px;margin:0 auto 36px;line-height:1.6;">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="btn btn--accent">{{ section.settings.cta_label }}</a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank -%}
        <a href="{{ section.settings.cta2_url | default: '/pages/a-propos' }}" class="btn btn--outline">{{ section.settings.cta2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bannière principale",
  "settings": [
    {"type": "text",    "id": "eyebrow",    "label": "Texte eyebrow",       "default": "🇫🇷 Nouvelle collection"},
    {"type": "textarea","id": "heading",   "label": "Titre principal",     "default": "Fait en France. Pour la France."},
    {"type": "textarea","id": "subheading","label": "Sous-titre",          "default": "Des produits pensés pour ceux qui aiment leur pays."},
    {"type": "text",    "id": "cta_label", "label": "Bouton principal",     "default": "Découvrir la boutique"},
    {"type": "url",     "id": "cta_url",   "label": "Lien bouton principal"},
    {"type": "text",    "id": "cta2_label","label": "Bouton secondaire",    "default": "Notre histoire"},
    {"type": "url",     "id": "cta2_url",  "label": "Lien bouton secondaire"},
    {"type": "image_picker","id": "image", "label": "Image de fond (optionnel)"}
  ],
  "presets": [{"name": "Bannière principale"}]
}
{% endschema %}
