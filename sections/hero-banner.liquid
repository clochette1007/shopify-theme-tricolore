<style>
.hero { background: var(--color-primary); padding: 100px 24px; text-align: center; position: relative; overflow: hidden; }
.hero::before { content: ''; position: absolute; top: -50%; right: -10%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(237,41,57,0.2) 0%, transparent 70%); pointer-events: none; }
.hero-eyebrow { display: inline-block; background: var(--color-accent); color: #fff; font-size: 12px; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; padding: 6px 16px; border-radius: 2px; margin-bottom: 24px; }
.hero h1 { color: #fff; font-size: clamp(36px, 6vw, 72px); font-weight: 900; text-transform: uppercase; line-height: 1.1; margin-bottom: 20px; }
.hero-sub { color: rgba(255,255,255,0.8); font-size: clamp(16px, 2vw, 20px); max-width: 560px; margin: 0 auto 40px; line-height: 1.6; }
.hero-ctas { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
.hero-ctas .btn-primary { background: var(--color-accent); color: #fff; padding: 16px 36px; border-radius: 4px; font-weight: 800; font-size: 15px; text-decoration: none; text-transform: uppercase; letter-spacing: 0.1em; transition: opacity 0.2s; }
.hero-ctas .btn-primary:hover { opacity: 0.88; }
.hero-ctas .btn-outline { border: 2px solid rgba(255,255,255,0.6); color: #fff; padding: 16px 36px; border-radius: 4px; font-weight: 800; font-size: 15px; text-decoration: none; text-transform: uppercase; letter-spacing: 0.1em; transition: border-color 0.2s; }
.hero-ctas .btn-outline:hover { border-color: #fff; }
</style>

<section class="hero">
  {%- if section.settings.eyebrow != blank -%}
    <div class="hero-eyebrow">{{ section.settings.eyebrow }}</div>
  {%- endif -%}
  <h1>{{ section.settings.heading | default: 'Fait en France. Pour la France.' }}</h1>
  {%- if section.settings.subheading != blank -%}
    <p class="hero-sub">{{ section.settings.subheading }}</p>
  {%- endif -%}
  <div class="hero-ctas">
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="btn-primary">{{ section.settings.cta_label }}</a>
    {%- endif -%}
    {%- if section.settings.cta2_label != blank -%}
      <a href="{{ section.settings.cta2_url | default: '/pages/a-propos' }}" class="btn-outline">{{ section.settings.cta2_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bannière héro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "🇫🇷 Nouvelle collection 2026" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Fait en France. Pour la France." },
    { "type": "textarea", "id": "subheading", "label": "Sous-titre", "default": "Des produits pensés pour ceux qui aiment leur pays." },
    { "type": "text", "id": "cta_label", "label": "Bouton principal", "default": "Découvrir la boutique" },
    { "type": "url", "id": "cta_url", "label": "Lien bouton principal" },
    { "type": "text", "id": "cta2_label", "label": "Bouton secondaire", "default": "Notre histoire" },
    { "type": "url", "id": "cta2_url", "label": "Lien bouton secondaire" }
  ],
  "presets": [{ "name": "Bannière héro" }]
}
{% endschema %}
